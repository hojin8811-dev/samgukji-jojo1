    "timelineEvents": [
      {
        "year": 189,
        "month": 12,
        "title": "동탁이 \"나 혼자 5성!\" 하고 뽐냈어요",
        "text": "동탁: \"흥, 이 낙양은 내 거야~\" 여포: \"(적토마 시동) 할 말 있으면 나한테 해요.\""
      },
      {
        "year": 190,
        "month": 1,
        "title": "동탁이 우리 왕따시킨다던데?",
        "text": "원소: \"형들, 동탁이 우리랑 안 논대.\" 유비: \"그럼 가서 물어보자!\" 관우·장비: \"콜!\" — 다들 삐져서 총출동!"
      },
      {
        "year": 190,
        "month": 3,
        "title": "호로관에서 여포가 문 앞을 딱 막았어요",
        "text": "여포: \"이 문은 내 거야. 지나가려면 나 이겨 봐~\" 장비: \"형님, 저 사람 계속 문 앞에서 노려봐요.\""
      },
      {
        "year": 190,
        "month": 5,
        "title": "동탁이 낙양에 불 지르고 장안으로 이사 갔어요",
        "text": "동탁: \"집이 너무 커서 그래~ 새 집 계약했음!\" 손견: \"…그거 내가 들어갈 집인데?\""
      },
      {
        "year": 191,
        "month": 4,
        "title": "손견이 불탄 낙양에 입주했어요",
        "text": "손견: \"벽지가 다 탔지만 뷰는 좋네!\" 황개: \"대감, 이건 재개발이에요.\""
      },
      {
        "year": 192,
        "month": 4,
        "title": "동탁이 여포에게 퇴사 통보받았어요",
        "text": "여포: \"사표 대신 창 받으세요~\" 왕윤: \"오늘 회식은 없던 걸로.\""
      }
    ],
    "summary": "동탁 혼자 5성? 못 참지 — 전 영웅 집합!",
    "subtitle": "동탁 혼자 5성? 못 참지 — 전 영웅 집합!"
  },
