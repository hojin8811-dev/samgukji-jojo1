    "timelineEvents": [
      {
        "year": 199,
        "month": 1,
        "title": "원술, 황제를 칭했으나 보급을 잃다",
        "text": "원술: \"나는 황제다. 세금은 면제다.\" 조조: \"황제도 군량은 내야 한다.\""
      },
      {
        "year": 200,
        "month": 1,
        "title": "손책, 사냥길에서 갑작스레 목숨을 잃다",
        "text": "손권: \"형님의 자리를 이어받습니다… 이렇게 갑자기요?\" 주유: \"강동의 다음 수는 내일 정합니다.\""
      },
      {
        "year": 200,
        "month": 2,
        "title": "유비, 서주를 잃고 하북으로 몸을 피하다",
        "text": "유비: \"잠시 비운 사이 주인이 바뀌었구나.\" 장비: \"형님, 성문은 제가 지켰습니다.\""
      },
      {
        "year": 200,
        "month": 4,
        "title": "관우, 백마에서 안량을 베다",
        "text": "관우: \"수염은 남겨 주마. 목은 안 된다.\" 안량: \"…\""
      },
      {
        "year": 200,
        "month": 8,
        "title": "원소의 대군, 관도에 진을 치다",
        "text": "원소: \"군사 십만이면 이 땅은 내 것이다.\" 조조: \"병력의 수가 땅의 주인을 정하지는 않는다.\""
      },
      {
        "year": 200,
        "month": 10,
        "title": "조조, 오소의 군량 창고를 급습하다",
        "text": "조조: \"보급은 기다리지 않는다. 내가 가서 가져온다.\" 순유: \"주군, 이는 적진 한복판입니다.\""
      },
      {
        "year": 200,
        "month": 11,
        "title": "관도 결전 — 조조가 크게 이기다",
        "text": "조조: \"인재도 땅도 내 손에 있다.\" 원소: \"계산이 어긋났구나.\""
      },
      {
        "year": 202,
        "month": 5,
        "title": "원소 사후, 원씨 형제가 갈라서다",
        "text": "원담: \"형이 먼저다.\" 원상: \"아니, 동생인 내가 먼저다.\" 조조: \"잘 지켜보겠다.\""
      }
    ],
